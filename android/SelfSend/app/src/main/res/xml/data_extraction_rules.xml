<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Session cookies grant access to private files, so no app data may leave the device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
